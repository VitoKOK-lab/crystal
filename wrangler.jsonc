// OMA CRYSTAL — Cloudflare Worker config (Phase 1).
// database_id is a placeholder: the deploy workflow resolves the real ID
// from the account at deploy time (self-bootstrapping — see
// .github/workflows/deploy-cloudflare.yml), so no ID ever needs committing.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oma-crystal",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "dist-pages",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The SPA fallback answers BROWSER NAVIGATIONS to any unmatched path
    // with index.html, and the asset router runs before the Worker — so
    // clicking "log in" landed on the storefront homepage instead of
    // reaching the Worker's redirect (curl was unaffected: no
    // Sec-Fetch-Mode: navigate header, so the fallback never triggered,
    // which is why API checks looked green). These prefixes must reach
    // the Worker first.
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oma-crystal",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "oma-crystal-img"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    // Admin login whitelist. GOOGLE_CLIENT_ID is passed at deploy time
    // (--var) and GOOGLE_CLIENT_SECRET via wrangler secret — see
    // .github/workflows/deploy-cloudflare.yml.
    "ADMIN_EMAILS": "luxkey.tw@gmail.com,agent@tzgrotw.tw"
  }
}
